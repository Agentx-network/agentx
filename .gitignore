# Re-include Wails build configuration assets (these are inputs, not outputs).
# We have to un-ignore the parent directory first because git can't re-include
# children of an excluded directory — then exclude the actual compiled output
# (build/bin/) inside it.
!cmd/agentx-desktop/build/
!cmd/agentx-desktop/build/**
cmd/agentx-desktop/build/bin/

